rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSeedListing(id) {
      return id.matches('^list-[0-9]+$');
    }

    function isNumeric(val) {
      return val is float || val is int;
    }

    // 1. User Validation Helper
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.name is string && data.name.size() <= 200 &&
             data.role is string && (data.role == "recipient" || data.role == "restaurant") &&
             data.avatar is string && data.avatar.size() <= 1000 &&
             data.points is int && data.points >= 0 &&
             (!('isPremium' in data) || data.isPremium is bool) &&
             (!('savedCO2' in data) || isNumeric(data.savedCO2));
    }

    // 2. FoodListing Validation Helper
    function isValidListing(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.restaurantId is string && data.restaurantId.size() <= 128 &&
             data.restaurantName is string && data.restaurantName.size() <= 200 &&
             data.restaurantAddress is string && data.restaurantAddress.size() <= 400 &&
             isNumeric(data.lat) && isNumeric(data.lng) &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.category is string && (data.category == "bakery" || data.category == "meal" || data.category == "grocery" || data.category == "dessert") &&
             isNumeric(data.originalPrice) && data.originalPrice >= 0 &&
             isNumeric(data.discountedPrice) && data.discountedPrice >= 0 &&
             data.quantity is int && data.quantity >= 0 &&
             data.durationLeft is int &&
             data.expiryTime is string && data.expiryTime.size() <= 100 &&
             data.imageUrl is string && data.imageUrl.size() <= 1000 &&
             isNumeric(data.co2Saved) && data.co2Saved >= 0 &&
             data.status is string && (data.status == "available" || data.status == "claimed" || data.status == "completed") &&
             (!('dietaryTags' in data) || (data.dietaryTags is list && data.dietaryTags.size() <= 10));
    }

    // 3. Reservation Validation Helper
    function isValidReservation(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.listingId is string && data.listingId.size() <= 128 &&
             data.listingTitle is string && data.listingTitle.size() <= 200 &&
             data.restaurantName is string && data.restaurantName.size() <= 200 &&
             data.recipientId is string && data.recipientId.size() <= 128 &&
             data.recipientName is string && data.recipientName.size() <= 200 &&
             data.quantity is int && data.quantity > 0 &&
             isNumeric(data.totalPrice) && data.totalPrice >= 0 &&
             data.pickupCode is string && data.pickupCode.size() <= 8 &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             data.status is string && (data.status == "reserved" || data.status == "completed" || data.status == "cancelled");
    }

    // --- Users Collection Rules ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      
      allow create: if isSignedIn() && userId == request.auth.uid && 
                       request.resource.data.keys().hasAll(['uid', 'email', 'name', 'role', 'avatar', 'points']) &&
                       request.resource.data.keys().size() >= 6 &&
                       isValidUser(request.resource.data) &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.points == 0;
                       
      allow update: if isSignedIn() && userId == request.auth.uid &&
                       isValidUser(request.resource.data) &&
                       request.resource.data.uid == existing().uid &&
                       request.resource.data.email == existing().email &&
                       request.resource.data.role == existing().role &&
                       request.resource.data.name == existing().name &&
                       (
                         request.resource.data.diff(existing()).affectedKeys().hasOnly(['points', 'isPremium', 'savedCO2', 'avatar'])
                       );
      allow delete: if false;
    }

    // --- FoodListings Collection Rules ---
    match /listings/{listingId} {
      allow get: if true;
      allow list: if true;

      allow create: if (isSeedListing(listingId) || (isSignedIn() && 
                       request.resource.data.restaurantId == request.auth.uid)) &&
                       isValidId(listingId) &&
                       isValidListing(request.resource.data);

      allow update: if isSignedIn() && 
                       isValidListing(request.resource.data) && 
                       (
                         (existing().restaurantId == request.auth.uid && request.resource.data.restaurantId == existing().restaurantId) ||
                         (request.resource.data.diff(existing()).affectedKeys().hasOnly(['quantity', 'status']))
                       );

      allow delete: if isSignedIn() && existing().restaurantId == request.auth.uid;
    }

    // --- Reservations Collection Rules ---
    match /reservations/{reservationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      function _unused_old_rules() {
        return (
                    resource.data.recipientId == request.auth.uid ||
                    get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.restaurantId == request.auth.uid
                 );
      }
                 
      // simplified list allowed above

      allow create: if isSignedIn() &&
                       request.resource.data.recipientId == request.auth.uid && 
                       isValidId(reservationId) &&
                       isValidReservation(request.resource.data) &&
                       exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId)) &&
                       get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == "available";

      allow update: if isSignedIn() &&
                       isValidReservation(request.resource.data) &&
                       (
                         (resource.data.recipientId == request.auth.uid && request.resource.data.diff(existing()).affectedKeys().hasOnly(['status'])) ||
                         (get(/databases/$(database)/documents/listings/$(existing().listingId)).data.restaurantId == request.auth.uid && request.resource.data.diff(existing()).affectedKeys().hasOnly(['status']))
                       );
                       
      allow delete: if false;
    }

  }
}
